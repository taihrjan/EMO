# Groq API для генерации промптов
GROQ_API_KEY=gsk_your_groq_api_key_here

# fal.ai для генерации фото (Stable Diffusion, FLUX, и др.)
FAL_API_KEY=your_fal_api_key_here

# Google Sheets для сохранения результатов
GOOGLE_SHEETS_KEY_PATH=./google_sheets_key.json
GOOGLE_SHEET_ID=your_sheet_id_here

# Настройки генерации
DAILY_PHOTO_COUNT=160
DAILY_VIDEO_COUNT=30
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STYLE=realistic
VIDEO_DURATION_SECONDS=30
VIDEO_FPS=24

# Groq модель
GROQ_MODEL=mixtral-8x7b-32768

# fal.ai модель для изображений
# Варианты: flux, flux-pro, flux-realism, stable-diffusion-3, и др.
FAL_MODEL=flux

# Языки
LANGUAGE=ru
TEXT_TO_SPEECH_LANGUAGE=ru

# Уведомления (опционально)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Логирование
LOG_LEVEL=INFO
DEBUG_MODE=False
